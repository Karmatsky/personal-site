# Server-side contact form forwarding.
# Use the Formspree form id only on the server. The old VITE_FORMSPREE_ID is no longer needed.
FORMSPREE_ID=your_formspree_form_id

# Public site origin used by the contact API origin/referer check.
SITE_ORIGIN=https://karmatsky.vercel.app

# Optional comma-separated extra allowed origins, useful for preview deployments.
CONTACT_ALLOWED_ORIGINS=

# Production-safe rate limiting and duplicate submission storage.
# Create an Upstash Redis database and copy its REST credentials.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Salt for anonymized IP/email/message hashes in server logs.
CONTACT_HASH_SALT=replace_with_a_long_random_secret
