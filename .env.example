# Preferred: full Formspree endpoint.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Alternative: short Formspree id. Used only when VITE_FORMSPREE_ENDPOINT is empty.
VITE_FORMSPREE_ID=your_form_id

# Used for the email draft fallback when Formspree is not configured or unavailable.
VITE_CONTACT_EMAIL=s.karmatsky@gmail.com
